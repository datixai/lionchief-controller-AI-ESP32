# .env.example — copy to .env and fill in real values
# Never commit .env to GitHub

# MAC address of Peter's outer loop train
# Find using: python scan_train.py  OR  nRF Connect app
TRAIN_MAC=AA:BB:CC:DD:EE:FF

# Camera device index (0 = first USB camera)
CAMERA_INDEX=0

# Model type: yolo | yolo_ncnn | tflite | mock
MODEL_TYPE=mock
